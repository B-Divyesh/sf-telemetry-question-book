{
  "routes": [
    { "route": "/assets/index-*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=86400, must-revalidate" } },
    { "route": "/", "rewrite": "/index.html" },
    { "route": "/demo", "rewrite": "/index.html" },
    { "route": "/demo/snapshot", "rewrite": "/index.html" },
    { "route": "/book", "rewrite": "/index.html" },
    { "route": "/privacy", "rewrite": "/index.html" },
    { "route": "/terms", "rewrite": "/index.html" },
    { "route": "/snapshot", "rewrite": "/index.html" },
    { "route": "/s/*", "rewrite": "/index.html" },
    { "route": "/sample-sources/northstar-orders", "rewrite": "/index.html" },
    { "route": "/sample-sources/atlas-webhooks", "rewrite": "/index.html" },
    { "route": "/sample-sources/harbor-export", "rewrite": "/index.html" }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "mimeTypes": { ".webmanifest": "application/manifest+json" }
}
